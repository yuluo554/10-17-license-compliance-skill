# 源码包（sdist）清单：让两种发布形态都自足。
#
# D12 已于 2026-10-19（阶段三）修正：规则包不再只进 sdist，`references/` 与
# `data/` 同时通过 `[tool.setuptools.package-data]` 打进 **wheel**，使
# `pip install licaudit` 开箱可用。sdist 的这一段保留，两种形态都不依赖安装后另取规则包。
#
# 冻结数据（references/spdx/manifest.json、data/truth/*.json）的字节由
# .gitattributes 的 `-text` 与生成器 `--check` 共同守着；两种包都只做原样打包。

include LICENSE
include README.md
include SKILL.md
include pyproject.toml
include MANIFEST.in
include .gitattributes
include .gitignore

recursive-include src/licaudit *.py
recursive-include scripts *.py
recursive-include tests *.py
recursive-include tools *.py *.md
recursive-include references *.json *.md
recursive-include data *.json *.md *.txt *.toml *.mod *.xml
recursive-include examples *.md *.csv
recursive-include plan *.md
recursive-include .github *.yml

# 一次性变异验证脚本与临时产物不进发布面
exclude tools/_mutate_m2.py
exclude tools/_mutate_m3.py
exclude tools/_mutate_m4.py
exclude tools/_mutate_m5.py
exclude tools/_mutate_m6.py
exclude tools/_scan_desensitize.py
prune out
prune dist
prune .pytest_cache
prune src/licaudit.egg-info
global-exclude __pycache__
global-exclude *.py[cod]
